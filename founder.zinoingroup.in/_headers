# Global Security & Caching Headers for All Routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: public, max-age=3600, must-revalidate

# Long-Lived Immutable Cache for Static Media Assets & Scripts
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

# Freshness & Edge Revalidation for JSON Content
/data/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Favicon Caching
/favicon.ico
  Cache-Control: public, max-age=604800, must-revalidate

# Search Crawler Directive Caching
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

# 404 Error Page Crawler Directive
/404.html
  X-Robots-Tag: noindex, follow

