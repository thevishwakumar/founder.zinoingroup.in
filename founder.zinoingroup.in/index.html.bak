                j = d.createElement(s),
                dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src =
                'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-N4T5ZSJJ');
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vishwa K - Cybersecurity & Marketing Professional</title>

    <!-- SEO Meta Tags -->
    <meta name="description" content="Professional portfolio of Vishwa K - Cybersecurity student and Marketing expert with 1.5 years of experience.">
    <meta name="keywords" content="Cybersecurity, Digital Marketing, Marketing Analytics, Vishwa K, Portfolio">
    <meta name="author" content="Vishwa K">

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="favicon.ico">
    <link rel="icon" type="image/png" href="assets/img/about.jpg">
    <link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
    <link href="https://cdn.jsdelivr.net/npm/boxicons@2.0.5/css/boxicons.min.css" rel="stylesheet" />
    <style>
        /*===== GOOGLE FONTS =====*/

        @import url("https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap");
        /*===== VARIABLES CSS =====*/

        :root {
            --header-height: 3rem;
            --font-semi: 600;
            /* Light theme colors */
            --hue-color: 224;
            --first-color: hsl(var(--hue-color), 89%, 60%);
            --second-color: hsl(var(--hue-color), 56%, 12%);
            --bg-color: #fff;
            --text-color: var(--second-color);
            --card-bg: #fff;
            --shadow-color: rgba(146, 161, 176, 0.15);
            /*===== Fuente y tipografia =====*/
            --body-font: 'Poppins', sans-serif;
            --big-font-size: 1.75rem;
            --h2-font-size: 1.25rem;
            --normal-font-size: .938rem;
            --smaller-font-size: .75rem;
            /*===== Margenes =====*/
            --mb-1: 0.5rem;
            --mb-2: 1rem;
            --mb-3: 1.5rem;
            --mb-4: 2rem;
            --mb-5: 2.5rem;
            --mb-6: 3rem;
            /*===== z index =====*/
            --z-back: -10;
            --z-fixed: 100;
        }

        /* Dark theme variables */

        [data-theme="dark"] {
            --first-color: hsl(var(--hue-color), 89%, 60%);
            --second-color: hsl(var(--hue-color), 8%, 75%);
            --bg-color: hsl(var(--hue-color), 28%, 12%);
            --text-color: hsl(var(--hue-color), 8%, 75%);
            --card-bg: hsl(var(--hue-color), 28%, 16%);
            --shadow-color: rgba(0, 0, 0, 0.25);
        }

        @media screen and (min-width: 768px) {
            :root {
                --big-font-size: 3rem;
                --h2-font-size: 1.5rem;
                --normal-font-size: 1rem;
                --smaller-font-size: .875rem;
            }
        }

        @media screen and (min-width: 992px) {
            :root {
                --big-font-size: 3.5rem;
            }
        }

        /*===== BASE =====*/

        *,
        ::before,
        ::after {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: var(--header-height) 0 0 0;
            font-family: var(--body-font);
            font-size: var(--normal-font-size);
            color: var(--text-color);
            background-color: var(--bg-color);
            transition: background-color 0.5s, color 0.5s;
            overflow-x: hidden;
            line-height: 1.6;
        }

        h1,
        h2,
        p {
            margin: 0;
        }

        ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        a {
            text-decoration: none;
        }

        img {
            max-width: 100%;
            height: auto;
            display: block;
        }

        /*===== CLASS CSS ===== */

        .section-title {
            position: relative;
            font-size: var(--h2-font-size);
            color: var(--first-color);
            margin-top: var(--mb-3);
            margin-bottom: var(--mb-4);
            text-align: center;
        }

        .section-title::after {
            position: absolute;
            content: '';
            width: 64px;
            height: 0.18rem;
            left: 0;
            right: 0;
            margin: auto;
            top: 2rem;
            background-color: var(--first-color);
        }

        .section {
            padding-top: 2rem;
            padding-bottom: 2rem;
        }

        /*===== LAYOUT =====*/

        .bd-grid {
            max-width: 1024px;
            display: grid;
            margin-left: var(--mb-2);
            margin-right: var(--mb-2);
        }

        .l-header {
            width: 100%;
            position: fixed;
            top: 0;
            left: 0;
            z-index: var(--z-fixed);
            background-color: var(--bg-color);
            box-shadow: 0 1px 4px var(--shadow-color);
            transition: background-color 0.5s, box-shadow 0.5s;
        }

        /* Theme Toggle */

        .theme-toggle {
            background: none;
            border: none;
            color: var(--text-color);
            font-size: 1.5rem;
            cursor: pointer;
            margin-left: var(--mb-2);
            transition: transform 0.3s;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background-color: var(--card-bg);
            box-shadow: 0 2px 10px var(--shadow-color);
        }

        .theme-toggle:hover {
            transform: rotate(15deg);
        }

        /*===== NAV =====*/

        .nav {
            height: var(--header-height);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-weight: var(--font-semi);
            padding: 0 var(--mb-2);
        }

        .nav__list {
            display: flex;
            flex-direction: column;
            padding-top: var(--mb-4);
        }

        .nav__item {
            margin-bottom: var(--mb-4);
        }

        .nav__link {
            position: relative;
            color: var(--text-color);
            transition: color 0.3s;
            font-size: 1.1rem;
        }

        .nav__link:hover {
            color: var(--first-color);
        }

        .nav__link:hover::after {
            position: absolute;
            content: '';
            width: 100%;
            height: 0.18rem;
            left: 0;
            top: 2rem;
            background-color: var(--first-color);
        }

        .nav__logo {
            color: var(--text-color);
            font-weight: 700;
            font-size: 1.2rem;
        }

        .nav__toggle {
            color: var(--text-color);
            font-size: 1.5rem;
            cursor: pointer;
            transition: transform 0.3s;
            z-index: var(--z-fixed);
        }

        .nav__toggle:hover {
            transform: scale(1.1);
        }

        /* Mobile Menu */

        @media screen and (max-width: 767px) {
            .nav__menu {
                position: fixed;
                top: 0;
                right: -100%;
                width: 80%;
                height: 100vh;
                padding: 6rem 2rem 2rem;
                background-color: var(--card-bg);
                transition: .5s;
                box-shadow: -2px 0 10px var(--shadow-color);
                z-index: var(--z-fixed);
                overflow-y: auto;
            }
            .nav__menu.show {
                right: 0;
            }
            .nav__toggle-close {
                position: absolute;
                top: 1rem;
                right: 1rem;
                font-size: 1.5rem;
                color: var(--text-color);
                cursor: pointer;
            }
        }

        /*Active menu*/

        .active::after {
            position: absolute;
            content: '';
            width: 100%;
            height: 0.18rem;
            left: 0;
            top: 2rem;
            background-color: var(--first-color);
        }

        /*===== HOME =====*/

        .home {
            position: relative;
            padding: 4rem 0 3rem;
            min-height: calc(100vh - var(--header-height));
            display: flex;
            align-items: center;
            text-align: center;
        }

        .home__data {
            align-self: center;
            z-index: 1;
            width: 100%;
        }

        .home__title {
            font-size: var(--big-font-size);
            margin-bottom: var(--mb-3);
            line-height: 1.2;
        }

        .home__title-color {
            color: var(--first-color);
            position: relative;
            display: inline-block;
        }

        .home__title-color::after {
            content: '';
            position: absolute;
            width: 100%;
            height: 4px;
            bottom: -5px;
            left: 0;
            background: linear-gradient(90deg, var(--first-color), transparent);
            border-radius: 2px;
        }

        .home__social {
            display: flex;
            justify-content: center;
            margin-top: var(--mb-4);
            gap: var(--mb-2);
        }

        .home__social-icon {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            font-size: 1.5rem;
            color: var(--text-color);
            background-color: var(--card-bg);
            box-shadow: 0 4px 10px var(--shadow-color);
            transition: all 0.3s;
        }

        .home__social-icon:hover {
            color: var(--first-color);
            transform: translateY(-3px);
        }

        /* Typing Animation */

        .typing-container {
            display: inline-block;
            margin-top: var(--mb-1);
        }

        .typing-text {
            border-right: 2px solid var(--first-color);
            white-space: nowrap;
            overflow: hidden;
            animation: typing 3.5s steps(40, end), blink-caret 0.75s step-end infinite;
        }

        /*BUTTONS*/

        .button {
            display: inline-block;
            background-color: var(--first-color);
            color: #fff;
            padding: .75rem 2rem;
            font-weight: var(--font-semi);
            border-radius: .5rem;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
            z-index: 1;
            margin-top: var(--mb-2);
        }

        .button::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transition: left 0.5s;
            z-index: -1;
        }

        .button:hover {
            box-shadow: 0px 10px 36px rgba(0, 0, 0, 0.15);
            transform: translateY(-3px);
        }

        .button:hover::before {
            left: 100%;
        }

        /* ===== ABOUT =====*/

        .about__container {
            row-gap: 2rem;
            text-align: center;
        }

        .about__subtitle {
            margin-bottom: var(--mb-2);
            color: var(--first-color);
            font-size: 1.2rem;
        }

        .about__img {
            justify-self: center;
        }

        .about__img img {
            width: 200px;
            border-radius: .5rem;
            box-shadow: 0 10px 30px var(--shadow-color);
            transition: transform 0.3s;
            margin: 0 auto;
        }

        .about__img img:hover {
            transform: scale(1.05);
        }

        .personal-info {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-top: var(--mb-4);
        }

        @media screen and (max-width: 576px) {
            .personal-info {
                grid-template-columns: 1fr;
            }
        }

        .info-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 1rem;
            background-color: var(--card-bg);
            border-radius: .5rem;
            box-shadow: 0px 4px 15px var(--shadow-color);
            transition: transform 0.3s;
        }

        .info-item:hover {
            transform: translateY(-5px);
        }

        .info-icon {
            font-size: 1.5rem;
            color: var(--first-color);
            margin-bottom: .5rem;
        }

        /* ===== SKILLS =====*/

        .skills__container {
            row-gap: 2rem;
            text-align: center;
        }

        .skills__subtitle {
            margin-bottom: var(--mb-2);
            color: var(--first-color);
            font-size: 1.2rem;
        }

        .skills__text {
            margin-bottom: var(--mb-4);
        }

        .skills-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
            margin-bottom: var(--mb-4);
        }

        .skill-item {
            background-color: var(--card-bg);
            padding: 1rem;
            border-radius: .5rem;
            box-shadow: 0px 4px 15px var(--shadow-color);
            text-align: center;
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .skill-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .skill-item:hover {
            transform: translateY(-5px);
        }

        .skill-item:hover::before {
            left: 100%;
        }

        .skill-icon {
            font-size: 2rem;
            color: var(--first-color);
            margin-bottom: .5rem;
        }

        .languages-container {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 1rem;
            margin-top: var(--mb-4);
        }

        .language-item {
            background-color: var(--card-bg);
            padding: .5rem 1rem;
            border-radius: 2rem;
            box-shadow: 0px 4px 15px var(--shadow-color);
            transition: all 0.3s;
            font-size: 0.9rem;
        }

        .language-item:hover {
            transform: translateY(-3px);
            background-color: var(--first-color);
            color: white;
        }

        /* Resume Information Styles */

        .resume-section {
            margin-top: var(--mb-4);
            text-align: left;
        }

        .resume-category {
            font-size: 1.2rem;
            color: var(--first-color);
            margin-bottom: var(--mb-2);
            border-bottom: 2px solid var(--first-color);
            padding-bottom: 0.5rem;
        }

        .resume-item {
            margin-bottom: var(--mb-2);
        }

        .resume-item-title {
            font-weight: var(--font-semi);
            margin-bottom: 0.25rem;
        }

        .resume-item-details {
            font-size: var(--smaller-font-size);
            color: var(--text-color);
            opacity: 0.8;
            margin-bottom: 0.5rem;
        }

        /* ===== EDUCATION =====*/

        .education__container {
            row-gap: 2rem;
        }

        .education__item {
            background-color: var(--card-bg);
            border-radius: .5rem;
            padding: 1.5rem;
            box-shadow: 0px 4px 25px var(--shadow-color);
            margin-bottom: var(--mb-4);
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .education__item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background-color: var(--first-color);
        }

        .education__item:hover {
            transform: translateY(-5px);
        }

        .education__title {
            font-size: var(--h2-font-size);
            color: var(--first-color);
            margin-bottom: var(--mb-1);
        }

        .education__org {
            font-weight: var(--font-semi);
            margin-bottom: var(--mb-1);
        }

        .education__date {
            font-size: var(--smaller-font-size);
            color: var(--text-color);
            opacity: 0.7;
            margin-bottom: var(--mb-2);
        }

        /* ===== CERTIFICATES =====*/

        .certificates__container {
            row-gap: 2rem;
        }

        .certificate__item {
            background-color: var(--card-bg);
            border-radius: .5rem;
            padding: 1.5rem;
            box-shadow: 0px 4px 25px var(--shadow-color);
            margin-bottom: var(--mb-4);
            transition: all 0.3s;
            position: relative;
            overflow: hidden;
        }

        .certificate__item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background-color: var(--first-color);
        }

        .certificate__item:hover {
            transform: translateY(-5px);
        }

        .certificate__title {
            font-size: 1.1rem;
            color: var(--first-color);
            margin-bottom: var(--mb-1);
        }

        .certificate__org {
            font-weight: var(--font-semi);
            margin-bottom: var(--mb-1);
        }

        .certificate__date {
            font-size: var(--smaller-font-size);
            color: var(--text-color);
            opacity: 0.7;
        }

        /* ===== CONTACT =====*/

        .contact__input {
            width: 100%;
            font-size: var(--normal-font-size);
            font-weight: var(--font-semi);
            padding: 1rem;
            border-radius: .5rem;
            border: 1.5px solid var(--text-color);
            outline: none;
            margin-bottom: var(--mb-4);
            background-color: var(--card-bg);
            color: var(--text-color);
            transition: all 0.3s;
        }

        .contact__input:focus {
            border-color: var(--first-color);
            box-shadow: 0 0 0 2px rgba(var(--hue-color), 89%, 60%, 0.2);
        }

        .contact__button {
            display: block;
            border: none;
            outline: none;
            font-size: var(--normal-font-size);
            cursor: pointer;
            margin-left: auto;
            width: 100%;
        }

        textarea.contact__input {
            resize: vertical;
            min-height: 150px;
        }

        /* ===== FOOTER =====*/

        .footer {
            background-color: #000;
            /* Changed to black */
            color: #fff;
            text-align: center;
            font-weight: var(--font-semi);
            padding: 2rem 0;
        }

        .footer__title {
            font-size: 1.5rem;
            margin-bottom: var(--mb-3);
        }

        .footer__social {
            margin-bottom: var(--mb-3);
            display: flex;
            justify-content: center;
            gap: var(--mb-2);
        }

        .footer__icon {
            font-size: 1.5rem;
            color: #fff;
            transition: all 0.3s;
        }

        .footer__icon:hover {
            color: var(--first-color);
            transform: translateY(-3px);
        }

        .footer__copy {
            font-size: var(--smaller-font-size);
        }

        /* ===== MEDIA QUERIES =====*/

        @media screen and (min-width: 576px) {
            .home {
                padding: 5rem 0 2rem;
                text-align: left;
            }
            .home__social {
                justify-content: flex-start;
            }
            .about__container {
                grid-template-columns: repeat(2, 1fr);
                align-items: center;
                text-align: initial;
            }
            .skills-grid {
                grid-template-columns: repeat(3, 1fr);
            }
            .education__container {
                grid-template-columns: repeat(2, 1fr);
                column-gap: 2rem;
            }
            .certificates__container {
                grid-template-columns: repeat(2, 1fr);
                column-gap: 2rem;
            }
            .contact__form {
                width: 100%;
                max-width: 400px;
                margin: 0 auto;
            }
        }

        @media screen and (min-width: 768px) {
            body {
                margin: 0;
            }
            .section {
                padding-top: 3rem;
                padding-bottom: 3rem;
            }
            .section-title {
                margin-bottom: var(--mb-5);
            }
            .section-title::after {
                width: 80px;
                top: 3rem;
            }
            .nav {
                height: calc(var(--header-height) + 1rem);
            }
            .nav__list {
                flex-direction: row;
                padding-top: 0;
            }
            .nav__item {
                margin-left: var(--mb-4);
                margin-bottom: 0;
            }
            .nav__toggle {
                display: none;
            }
            .nav__link {
                color: var(--text-color);
            }
            .home {
                padding: 8rem 0 2rem;
            }
            .home__title {
                font-size: var(--big-font-size);
            }
            .about__img img {
                width: 250px;
            }
            .skills__container {
                grid-template-columns: 1fr;
                column-gap: 2rem;
                align-items: center;
                text-align: center;
            }
            .skills-grid {
                grid-template-columns: repeat(4, 1fr);
            }
            .certificates__container {
                grid-template-columns: repeat(3, 1fr);
            }
            .contact__button {
                width: auto;
            }
        }

        @media screen and (min-width: 992px) {
            .bd-grid {
                margin-left: auto;
                margin-right: auto;
            }
            .home {
                padding: 10rem 0 2rem;
            }
            .about__img img {
                width: 300px;
            }
            .skills-grid {
                grid-template-columns: repeat(5, 1fr);
            }
            .certificates__container {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        /* Animations */

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInRight {
            from {
                opacity: 0;
                transform: translateX(40px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes fadeInLeft {
            from {
                opacity: 0;
                transform: translateX(-40px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        @keyframes scaleIn {
            from {
                opacity: 0;
                transform: scale(0.9);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }

        .fade-in-up {
            animation: fadeInUp 1s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        /* Staggered Animation Delays */

        .delay-1 {
            animation-delay: 0.1s;
        }

        .delay-2 {
            animation-delay: 0.2s;
        }

        .delay-3 {
            animation-delay: 0.3s;
        }

        .delay-4 {
            animation-delay: 0.4s;
        }

        .delay-5 {
            animation-delay: 0.5s;
        }

        /* Typing Animation */

        @keyframes typing {
            from {
                width: 0
            }
            to {
                width: 100%
            }
        }

        @keyframes blink-caret {
            from,
            to {
                border-color: transparent
            }
            50% {
                border-color: var(--first-color);
            }
        }

        /* Scroll Animation Enhanced */

        .scroll-animate {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 1s cubic-bezier(0.23, 1, 0.32, 1), transform 1s cubic-bezier(0.23, 1, 0.32, 1);
            will-change: transform, opacity;
        }

        .scroll-animate.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* Hover Micro-interactions */

        .button,
        .home__social-icon,
        .info-item,
        .skill-item,
        .education__item,
        .certificate__item {
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease, background-color 0.4s ease;
        }

        .button:hover,
        .home__social-icon:hover {
            transform: translateY(-5px) scale(1.02);
            box-shadow: 0 10px 20px var(--shadow-color);
        }

        .skill-item:hover,
        .info-item:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px var(--shadow-color);
        }

        /* Contact Form Result Messages */

        .contact__result {
            display: none;
            margin-top: var(--mb-2);
            font-weight: var(--font-semi);
            text-align: center;
            font-size: var(--normal-font-size);
            opacity: 0;
            transition: opacity 0.5s ease-in-out;
            width: 100%;
        }

        .contact__result.show {
            display: block;
            opacity: 1;
        }

        .contact__result.success {
            color: #28a745;
            /* Green */
        }

        .contact__result.error {
            color: #dc3545;
            /* Red */
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeIn 0.5s ease-in-out forwards;
        }

        /* Mobile menu overlay */

        .overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 99;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s, visibility 0.3s;
        }

        .overlay.show {
            opacity: 1;
            visibility: visible;
        }

        /* Page Load Animation */

        body {
            opacity: 0;
            animation: pageFadeIn 1s cubic-bezier(0.23, 1, 0.32, 1) forwards;
        }

        @keyframes pageFadeIn {
            to {
                opacity: 1;
            }
        }
    </style>
</head>

