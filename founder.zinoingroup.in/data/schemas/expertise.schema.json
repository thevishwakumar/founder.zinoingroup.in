{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExpertiseContentSchema",
  "description": "Schema for areas of technical expertise on founder.zinoingroup.in",
  "type": "object",
  "required": ["categories"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "icon", "skills"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "icon": { "type": "string" },
          "skills": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
