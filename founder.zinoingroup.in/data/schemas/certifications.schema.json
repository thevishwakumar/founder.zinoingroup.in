{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CertificationsContentSchema",
  "description": "Schema for verified certifications and credentials on founder.zinoingroup.in",
  "type": "object",
  "required": ["certifications"],
  "properties": {
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "organization"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 2, "maxLength": 100 },
          "organization": { "type": "string", "minLength": 2, "maxLength": 80 },
          "orgIcon": { "type": "string" },
          "footerLabel": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "isVerified": { "type": "boolean" },
          "link": {
            "type": ["object", "null"],
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "text": { "type": "string" },
              "title": { "type": "string" }
            },
            "required": ["url"]
          }
        }
      }
    }
  }
}
